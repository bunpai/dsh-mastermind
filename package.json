{
  "name": "dsh-advisor-mode",
  "version": "0.1.0",
  "description": "DSH advisor-mode plugin prototype: small executor model leads, consults a stronger advisor model only at stuck points (opening plan / automatic followup / consult_advisor tool).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-cordis"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "lib",
    "dshx.yml",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-cordis": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "bun-types": "^1.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "advisor-mode",
    "qwenpaw"
  ]
}
